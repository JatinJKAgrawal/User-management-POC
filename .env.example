# ---- Application ---------------------------------------------------------
# development | staging | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# text | json (json is forced in production)
LOG_FORMAT=text
# used to build onboarding links
APP_PUBLIC_BASE_URL=http://localhost:8080

# ---- HTTP ----------------------------------------------------------------
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=20s
# comma separated CIDRs / IPs of reverse proxies
HTTP_TRUSTED_PROXIES=

# ---- Database ------------------------------------------------------------
DATABASE_URL=postgres://app:app@localhost:5432/usermgmt?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2

# ---- JWT -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-32+-chars
JWT_ISSUER=user-management
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
JWT_PASSWORD_SETUP_TTL=30m

# ---- Platform (super admin) ------------------------------------------------
# Protects /api/v1/platform/* (tenant provisioning). Generate with: openssl rand -hex 32
PLATFORM_API_KEY=change-me-platform-api-key

# ---- Onboarding ----------------------------------------------------------
ONBOARDING_INVITE_TTL=72h
# Frontend "set password" page. If set, the email link redirects browsers here
# with ?token=<password-setup JWT>. Leave empty to always return JSON.
ONBOARDING_SET_PASSWORD_URL=

# ---- Mail ----------------------------------------------------------------
# smtp | log
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
